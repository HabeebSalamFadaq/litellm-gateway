###############################################################################
# Environment variable template
# ---------------------------------------------------------------------------
# Copy this file to a safe place (NOT the repo) and fill in real secrets.
# On Railway, set these as service Variables instead of using this file.
# NEVER commit real secrets to the repo.
###############################################################################

# Strong random string. Anything. The Claude Code client uses this as the
# bearer token. Treat it as a secret and rotate it if leaked.
LITELLM_MASTER_KEY=sk-replace-me-with-a-long-random-string-at-least-32-chars

# ---------------------------------------------------------------------------
# Google Gemini - 6 keys cycled by LiteLLM within the same model_name
# ---------------------------------------------------------------------------
GEMINI_API_KEY_1=AIza...
GEMINI_API_KEY_2=AIza...
GEMINI_API_KEY_3=AIza...
GEMINI_API_KEY_4=AIza...
GEMINI_API_KEY_5=AIza...
GEMINI_API_KEY_6=AIza...

# ---------------------------------------------------------------------------
# OpenRouter - 4 keys cycled
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY_1=sk-or-v1-...
OPENROUTER_API_KEY_2=sk-or-v1-...
OPENROUTER_API_KEY_3=sk-or-v1-...
OPENROUTER_API_KEY_4=sk-or-v1-...

# ---------------------------------------------------------------------------
# OpenCode Zen - 1 key, 6 free models cycled
# ---------------------------------------------------------------------------
OPENCODE_ZEN_API_KEY=sk-...

# ---------------------------------------------------------------------------
# NVIDIA NIM - 1 key, 6 free coding models
# ---------------------------------------------------------------------------
NVIDIA_NIM_API_KEY=nvapi-...

# ---------------------------------------------------------------------------
# KiraAI (kiraai.vn) - 1 key, mostly PAID models, last-resort tier
# Set this to your key to enable the tier 5 fallback. If unset, the
# KiraAI tier is silently skipped (no fallback reaches it).
# ---------------------------------------------------------------------------
KIRAAI_API_KEY=kira_...

# ---------------------------------------------------------------------------
# Optional providers (uncomment model entries in config.yaml to enable)
# ---------------------------------------------------------------------------
# XAI_API_KEY=xai-...
# GROQ_API_KEY=gsk-...
# ANTHROPIC_API_KEY=sk-ant-...
