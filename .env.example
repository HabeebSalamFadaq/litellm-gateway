###############################################################################
# Environment variable template for litellm-gateway
# ---------------------------------------------------------------------------
# Copy this file to .env (which is gitignored) and fill in real keys, or set
# these directly in your Railway service's Variables tab.
# NEVER commit real keys to the repo.
###############################################################################

# ===========================================================================
# REQUIRED: master key for the gateway itself
# ===========================================================================
# Anything 32+ chars. This is the bearer token that Claude Code uses to
# authenticate to the gateway. Treat as a secret. Rotate if leaked.
LITELLM_MASTER_KEY=sk-replace-me-with-a-long-random-string-at-least-32-chars

# ===========================================================================
# OPTIONAL: salt key (only used if you add a database later)
# ===========================================================================
# NOT NEEDED for the current no-DB setup. If you add a database later,
# set this to a random 32-char string AND NEVER CHANGE IT — changing it
# makes any stored provider credentials undecryptable.
# LITELLM_SALT_KEY=sk-salt-set-once-and-never-change

# ===========================================================================
# OPTIONAL: bind port (defaults to 4000)
# ===========================================================================
# PORT=4000

# ===========================================================================
# TIER 1: Google Gemini (multi-key rotation)
# ===========================================================================
# Get free keys at https://aistudio.google.com
# The gateway load-balances across all GEMINI_API_KEY_1..10 that you set.
# Each free key has its own per-minute quota, so more keys = more throughput.
# Recommended models: gemini-2.5-flash, gemini-3.5-flash
# Avoid: gemini-2.5-pro (returns 404 for free keys)
GEMINI_API_KEY_1=AIza...
GEMINI_API_KEY_2=AIza...
GEMINI_API_KEY_3=AIza...
GEMINI_API_KEY_4=AIza...
GEMINI_API_KEY_5=AIza...
GEMINI_API_KEY_6=AIza...
GEMINI_API_KEY_7=AIza...
GEMINI_API_KEY_8=AIza...
GEMINI_API_KEY_9=AIza...
GEMINI_API_KEY_10=AIza...

# ===========================================================================
# TIER 2: OpenCode Zen (optional)
# ===========================================================================
# Get a free API key at https://opencode.ai/auth
# Works with free models like: hy3-free, nemotron-3-ultra-free,
# nemotron-3.5-lightning-free, muse-spark-1.2-contributor-free
# OPENCODE_ZEN_API_KEY=sk-...

# ===========================================================================
# TIER 3: OpenRouter (multi-key rotation)
# ===========================================================================
# Get free keys at https://openrouter.ai/keys
# The gateway load-balances across all OPENROUTER_API_KEY_1..4 that you set.
# Free models are 50 req/day per key. Recommended: 4 keys = 200/day total.
# Working free models: z-ai/glm-5.2:free, minimax/minimax-m3:free,
# nvidia/nemotron-3-super-120b-a12b:free, cohere/north-mini-code:free
OPENROUTER_API_KEY_1=sk-or-v1-...
OPENROUTER_API_KEY_2=sk-or-v1-...
OPENROUTER_API_KEY_3=sk-or-v1-...
OPENROUTER_API_KEY_4=sk-or-v1-...

# ===========================================================================
# TIER 4: NVIDIA NIM (REQUIRED for the free unlimited tier)
# ===========================================================================
# Get a free key at https://build.nvidia.com
# This is your main workhorse — essentially unlimited free inference.
# Working models: moonshotai/kimi-k3, nvidia/nemotron-3-super-120b-a12b,
# nvidia/nemotron-3-nano-30b-a3b, openai/gpt-oss-120b, openai/gpt-oss-20b
NVIDIA_NIM_API_KEY=nvapi-...

# ===========================================================================
# TIER 5: Groq (optional but fast)
# ===========================================================================
# Get free keys at https://console.groq.com
# The gateway load-balances across both GROQ_API_KEY_1 and GROQ_API_KEY_2
# if both are set. Working model: openai/gpt-oss-20b
GROQ_API_KEY_1=gsk-...
GROQ_API_KEY_2=gsk-...

# ===========================================================================
# TIER 6: TokenRouter (https://api.tokenrouter.com/v1)
# ===========================================================================
# OpenAI-compatible API. Free model: z-ai/glm-5.3-free
# TokenRouter routes to multiple free upstream providers.
TOKENROUTER_API_KEY_1=sk-...

# ===========================================================================
# NOT INCLUDED BY DEFAULT
# ===========================================================================
# The following providers are not enabled in the current config.yaml.
# To enable, add the appropriate deployment blocks to config.yaml and
# uncomment the env var here.
#
# xAI / Grok (https://console.x.ai): XAI_API_KEY=xai-...
# Anthropic direct (https://console.anthropic.com): ANTHROPIC_API_KEY=sk-ant-...
# KiraAI (paid in VND, leave disabled): KIRAAI_API_KEY=kira-...
